{
  "name": "avon-health-rag-backend",
  "version": "1.0.0",
  "description": "Backend API for Avon Health RAG System - HIPAA-compliant medical AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "test:accuracy": "npx tsx test-accuracy.ts",
    "test:quick": "npx tsx quick-test.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rag",
    "medical",
    "ai",
    "hipaa",
    "ollama"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chrono-node": "^2.9.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "lru-cache": "^11.2.2",
    "morgan": "^1.10.0",
    "uuid": "^8.3.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.0.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.13"
  }
}
